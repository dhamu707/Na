rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow reading and writing room media (images and audio) only for authenticated users
    match /rooms/{roomId}/{mediaType}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && (mediaType == "images" || mediaType == "audio")
                   && request.resource.size < 10 * 1024 * 1024; // 10MB limit per file
    }
    
  }
}
